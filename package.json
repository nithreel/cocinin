{
  "name": "cocinin",
  "version": "1.0.0",
  "description": "Despensa, lista de la compra y recetario compartidos (React + Firebase)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only firestore:rules,hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "setup": "node scripts/setup.mjs",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cocinin-rules \"vitest run tests/rules\""
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "firebase": "^12.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
