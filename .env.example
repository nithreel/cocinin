# Configuración web de tu proyecto Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
# Copia este fichero a .env y rellénalo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave pública VAPID para los avisos push (opcional; ver README). Se genera con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
