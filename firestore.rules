rules_version = '2';

// Acceso por membresía: un usuario es miembro si existe /users/{uid}.
// El primer usuario se crea desde la app (ver meta/setup) y a partir de ahí
// solo el admin puede dar de alta o quitar a otros. No hay UIDs escritos aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function setupDone() {
      return exists(/databases/$(database)/documents/meta/setup);
    }

    // Marca de "instalación hecha". Pública de lectura para que la pantalla de
    // login sepa si debe ofrecer crear el primer usuario.
    match /meta/setup {
      allow get: if true;
      allow create: if isSignedIn() && !setupDone() &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Marca de "restaurando copia": la escribe el admin al restaurar; el servicio de avisos (cuenta de servicio)
    // la lee para no avisar de cada cambio de la restauración.
    match /meta/restoring {
      allow write: if isAdmin();
    }

    function isAdmin() {
      return isMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    match /users/{uid} {
      allow read: if isMember() || (isSignedIn() && request.auth.uid == uid);
      // Primer usuario: se crea como admin a la vez que meta/setup, y solo si no hay instalación.
      // Después solo el admin da de alta a otros, siempre como 'member'.
      allow create: if
        (isSignedIn() && request.auth.uid == uid && !setupDone() &&
          request.resource.data.role == 'admin' &&
          existsAfter(/databases/$(database)/documents/meta/setup)) ||
        (isAdmin() && request.resource.data.role == 'member');
      // El admin puede poner o cambiar el alias de cualquiera (solo ese campo) y nombrar admin a un miembro
      // (solo el campo role, de member a admin): así se hace el relevo. Nadie baja de rango a otro.
      allow update: if isAdmin() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          resource.data.get('role', 'member') == 'member' && request.resource.data.role == 'admin'));
      // Solo el admin quita accesos, y nunca el suyo.
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /groups/{id} { allow read, write: if isMember(); }
    match /ingredients/{id} { allow read, write: if isMember(); }
    match /shoppingList/{id} { allow read, write: if isMember(); }
    match /recipes/{id} { allow read, write: if isMember(); }
    match /tags/{id} { allow read, write: if isMember(); }
    match /purchaseHistory/{id} { allow read, write: if isMember(); }
    match /notes/{id} { allow read, write: if isMember(); }

    // Avisos de prueba reales: el miembro pide uno para su dispositivo; el servicio de avisos (cuenta de
    // servicio, fuera de estas reglas) lo envía y anota el resultado.
    match /pushTests/{id} {
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      // (resource == null: la app escucha el documento justo antes de que exista)
      allow read: if isMember() && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Suscripciones push: cada miembro gestiona solo las suyas. La Raspberry las lee con la
    // cuenta de servicio (que no pasa por estas reglas).
    match /pushSubscriptions/{id} {
      allow read, delete: if isMember() && resource.data.uid == request.auth.uid;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
    }
  }
}
